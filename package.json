{
  "name": "qwen-free-api",
  "version": "1.0.0",
  "description": "Local OpenAI-compatible proxy to Qwen Chat v2 API with pure-JS SSXMOD WAF cookie generation",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "login": "node scripts/login.js",
    "accounts": "node scripts/accounts.js",
    "capture": "node scripts/login.js --cookie-only",
    "install:setup": "node scripts/install.js",
    "test": "node scripts/test-cookies.js && node scripts/offline-sse-test.js",
    "models": "node scripts/list-models.js",
    "daemon": "systemctl --user enable --now qwen-free-api",
    "daemon:stop": "systemctl --user stop qwen-free-api"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "puppeteer": "^25.5.0"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=18"
  }
}
