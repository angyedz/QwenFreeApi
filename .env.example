# Порт локального HTTP-сервера (прокси + веб-чат)
PORT=3265

# Рабочая директория для тулов агента (терминал/файлы) — "песочница"
QWEN_WORKSPACE=~/qwen-workspace

# Версия SPA-клиента chat.qwen.ai (требуется заголовком x-request-id/version).
# Обнови, если начнёт ловить WAF. Найди актуальное значение в DevTools -> Network -> любой
# запрос к chat.qwen.ai -> Request Headers -> version (например 0.2.81 / 0.2.83).
QWEN_WEB_VERSION=0.2.83

# Модель по умолчанию (если клиент не передаст model)
DEFAULT_MODEL=qwen3.8-max

# Уровень логов: debug|info|warn|error
LOG_LEVEL=info